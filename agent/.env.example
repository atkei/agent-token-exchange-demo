# --- LLM (OpenAI, fixed for this demo) ---
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5-mini

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8080
REALM=agents-demo

# The agent authenticates the RFC 8693 exchange with these credentials.
EXPENSE_AGENT_CLIENT_ID=expense-agent
EXPENSE_AGENT_CLIENT_SECRET=expense-agent-secret

# Used by the demo script to obtain the accountant's (subject) token.
EXPENSE_PORTAL_CLIENT_ID=expense-portal
ACCOUNTANT_USERNAME=accountant-123
ACCOUNTANT_PASSWORD=password

# --- Downstream API ---
EXPENSE_API_URL=http://localhost:8787
